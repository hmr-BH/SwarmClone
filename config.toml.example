# AI虚拟主播系统配置文件
# 复制此文件为 config.toml 并填入实际配置

[server]
# 服务主机地址
host = "0.0.0.0"
# WebSocket端口
websocket_port = 8080
# gRPC端口
grpc_port = 50051

[websocket]
# 是否启用WebSocket服务
enabled = true
# 心跳间隔（毫秒）
heartbeat_interval = 30000
# 连接超时（毫秒）
connection_timeout = 60000
# 最大连接数
max_connections = 100

[grpc]
# 是否启用gRPC服务
enabled = true
# protobuf文件路径
proto_path = "./proto/vtuber.proto"

[llm]
# LLM服务提供商: openai, azure, custom
provider = "openai"
# API密钥（必填）
api_key = "your-api-key-here"
# API基础URL（可选，用于自定义端点）
# base_url = "https://api.openai.com/v1"
# 模型名称
model = "gpt-4o-mini"
# 最大令牌数
max_tokens = 2048
# 温度参数
temperature = 0.7
# 系统提示词
system_prompt = """你是一个友善的虚拟主播助手，请用简洁、活泼的语气回应用户。"""

[tts]
# TTS服务提供商: openai, azure, custom
provider = "openai"
# API密钥（如果与LLM相同可留空）
api_key = ""
# 语音ID
voice_id = "alloy"
# 语速（0.25-4.0）
speed = 1.0
# 输出格式
format = "mp3"

[asr]
# ASR服务提供商: openai, azure, custom
provider = "openai"
# API密钥（如果与LLM相同可留空）
api_key = ""
# 语言代码
language = "zh"

[logging]
# 日志级别: trace, debug, info, warn, error, fatal
level = "info"
# 是否启用美化输出
pretty = true

# 开发模式配置（可选）
[dev]
# 是否启用开发模式
enabled = false
# 是否启用详细日志
verbose = false
